# ============================================
# EUPHORIA — Variables de Entorno (PLANTILLA)
# ============================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a Git (ya esta en .gitignore).

# --- SERVIDOR ---
PUERTO=3000
ENTORNO=desarrollo            # desarrollo | produccion

# --- BASE DE DATOS (MySQL) ---
URL_BASE_DATOS="mysql://usuario:password@127.0.0.1:3306/db_euphoria"

# --- JWT (Tokens) ---
JWT_SECRETO="genera_uno_con_openssl_rand_hex_64"
JWT_EXPIRACION="8h"
JWT_SECRETO_REFRESH="genera_otro_distinto"
JWT_EXPIRACION_REFRESH="7d"
JWT_SECRETO_QR="genera_otro_distinto_para_los_qr_de_pago"

# --- CLOUDINARY (Imagenes) ---
CLOUDINARY_NOMBRE_NUBE=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- SERVICIO IA ---
URL_SERVICIO_IA="http://localhost:8000"

# --- CORS (Origenes permitidos en produccion, separados por coma) ---
ORIGEN_FRONTEND="http://localhost:5173"

# --- OCR (depuracion) ---
DEBUG_OCR="false"
