# ---- Dependencias ----
node_modules/
**/node_modules/

# ---- Variables de entorno / secretos ----
.env
.env.*
**/.env
**/.env.*
# ...pero SÍ subimos las plantillas de ejemplo (sin secretos)
!.env.example
!**/.env.example

# ---- Compilados / builds ----
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Backups de base de datos (datos sensibles, NO subir) ----
recursos/generados/backups/
recursos/generados/backups-bd/

# ---- Credenciales de prueba (contrasenas, NO subir) ----
recursos/generados/CREDENCIALES*.txt
**/CREDENCIALES*.txt

# ---- Logs y temporales ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
scratch/
**/scratch/

# ---- Sistema operativo / editores ----
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json

# ---- Skills de diseno instaladas (reinstalables con skills-lock.json) ----
.agents/
.claude/skills/

# ---- Artefactos de Playwright (capturas/snapshots de pruebas) ----
.playwright-mcp/

# ---- OCR: dato de idioma de Tesseract (binario regenerable) y volcado de depuracion ----
**/spa.traineddata
**/comprobante.txt

# ---- Capturas de verificacion y muestras (temporales / datos personales) ----
recursos/generados/capturas-*/
recursos/generados/muestras-ocr/

# Dump para restaurar en Aiven (datos reales, no subir a git)
recursos/generados/*aiven*.sql
recursos/generados/iniciador-*.sql

# Copia del frontend que genera el build en Render (no versionar)
euphoria-backend/dist-frontend/
