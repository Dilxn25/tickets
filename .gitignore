# ============================================================
# Solo se versiona lo que el sistema necesita para funcionar:
#   euphoria-backend, euphoria-frontend, euphoria-ia,
#   documentacion-codigo, .github, render.yaml e iniciar-euphoria.ps1
# Todo lo demas vive solo en la computadora local.
# ============================================================

# ---- Material de trabajo local (tesis, capturas, respaldos, recursos) ----
/generados/
/recursos/
/docs/
/credenciales.txt
**/CREDENCIALES*.txt

# ---- Herramientas del editor y asistentes (configuracion local) ----
/.claude/
/.agents/
/.superpowers/
/.playwright-mcp/
/skills-lock.json
/workflows/

# ---- Dependencias ----
node_modules/
**/node_modules/

# ---- Variables de entorno / secretos ----
.env
.env.*
**/.env
**/.env.*
# ...pero SI subimos las plantillas de ejemplo (sin secretos)
!.env.example
!**/.env.example

# ---- Compilados / builds ----
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
# Copia del frontend que genera el build en Render
euphoria-backend/dist-frontend/

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
# Artefacto que deja un entrenamiento local (las versiones oficiales van en euphoria-ia/modelos)
euphoria-ia/entrenamiento/artefacto_modelo*.pkl

# ---- OCR: dato de idioma de Tesseract (binario regenerable) y volcado de depuracion ----
**/spa.traineddata
**/comprobante.txt

# ---- Logs y temporales ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
scratch/
**/scratch/
**/~$*.docx
**/~$*.xlsx
**/~WRL*.tmp

# ---- Sistema operativo / editores ----
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
